-- Overloads
-- ---------

[case testOverloadReorderedIsCompatible]
[file old/pkg/__init__.py]
from typing import overload
@overload
def conv(x: int) -> int: ...
@overload
def conv(x: str) -> str: ...
def conv(x): ...
[file new/pkg/__init__.py]
from typing import overload
@overload
def conv(x: str) -> str: ...
@overload
def conv(x: int) -> int: ...
def conv(x): ...
[out]

[case testOverloadVariantRemoved]
[file old/pkg/__init__.py]
from typing import overload
@overload
def conv(x: int) -> int: ...
@overload
def conv(x: str) -> str: ...
def conv(x): ...
[file new/pkg/__init__.py]
